# Raw source data: do NOT mirror the government API. Publish derived aggregates only.
# (out/ is ~1.5 GB of raw GeoJSONL layers: EC 262 MB, FC 535 MB, ...)
out/
nbwl_pdfs/
nbwl_page.html
boundaries/
*.pdf

# Private working notes (internal AI-agent context; contains candid infra notes)
CLAUDE.md

# Audit scratch / intermediates (not needed publicly)
query.json
query_2.json
parivesh_audit_report.json
parivesh_audit_report.csv
parivesh_audit_report.md

# Map build intermediates (regenerated by the pipeline). The map itself reads
# only proposals/<STATE>.json, state_counts.json, states.geojson and
# data_meta.json -- proposals.json and company_by_pno.json are inputs to a full
# rebuild, not shipped files, and the weekly updater does not need them either.
map_v1/_state_keys.json
map_v1/enrich_progress.json
map_v1/proposals.json
map_v1/proposals_excluded.json
map_v1/company_by_pno.json
# NOTE: map_v1/proposals_excluded/ (the DIRECTORY) is published and tracked --
# it is what makes the headline figure reproducible. Only the cold-build
# intermediate .json of the same name is ignored.

# Python / OS
__pycache__/
*.pyc
.venv/
env/
.DS_Store
Thumbs.db
